<script>
VANTA.GLOBE({el:'#xo-bg',mouseControls:true,touchControls:true,gyroControls:false,minHeight:200,minWidth:200,scale:1.0,color:0x1A4F8A,color2:0x56CCF2,backgroundColor:0x2D0A28,size:1.2});
var nav = document.getElementById('nav');
window.addEventListener('scroll', function() { nav.classList.toggle('s', window.scrollY > 40); });
var hbg = document.getElementById('hbg');
var mob = document.getElementById('mob');
hbg.addEventListener('click', function() {
  var isOpen = mob.classList.contains('open');
  mob.classList.toggle('open');
  document.body.style.overflow = isOpen ? '' : 'hidden';
});
mob.querySelectorAll('a').forEach(function(a) {
  a.addEventListener('click', function() {
    mob.classList.remove('open');
    document.body.style.overflow = '';
  });
});
document.addEventListener('click', function(e) {
  if (mob.classList.contains('open') && !mob.contains(e.target) && !hbg.contains(e.target)) {
    mob.classList.remove('open');
    document.body.style.overflow = '';
  }
});
window.addEventListener('resize', function() {
  if (window.innerWidth > 767) {
    mob.classList.remove('open');
    document.body.style.overflow = '';
  }
});
var counterObs = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      entry.target.querySelectorAll('[data-t]').forEach(function(el) {
        var target = +el.dataset.t, dur = 1600, step = target / dur * 16, cur = 0;
        if (target === 0) { el.textContent = '0'; return; }
        var iv = setInterval(function() {
          cur = Math.min(cur + step, target);
          el.textContent = Math.floor(cur);
          if (cur >= target) clearInterval(iv);
        }, 16);
      });
      counterObs.unobserve(entry.target);
    }
  });
}, { threshold: 0.3 });
document.querySelectorAll('.stats').forEach(function(el) { counterObs.observe(el); });
function switchTab(tabId, btn) {
  document.querySelectorAll('.tab').forEach(function(el) { el.classList.remove('active'); });
  document.querySelectorAll('.tab-content').forEach(function(el) { el.classList.remove('active'); });
  if (btn) btn.classList.add('active');
  var panel = document.getElementById('tab-' + tabId);
  if (panel) panel.classList.add('active');
}
var ro = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('vis'); });
}, { threshold: 0.1 });
document.querySelectorAll('.rev').forEach(function(el) { ro.observe(el); });
document.querySelectorAll('a[href^="#"]').forEach(function(a) {
  a.addEventListener('click', function(e) {
    e.preventDefault();
    var target = document.querySelector(a.getAttribute('href'));
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});
</script>
